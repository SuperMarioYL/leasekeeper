  "process": {
    "title": "What happens on one acquire",
    "steps": [
      {
        "title": "Declare the resource",
        "detail": "file:src/a.go — the caller names it"
      },
      {
        "title": "Read the lease table",
        "detail": "Free? Grant it and record the owner"
      },
      {
        "title": "Check the wait-for graph",
        "detail": "Would waiter -> holder close a cycle?"
      },
      {
        "title": "Grant, queue or refuse",
        "detail": "b -> a -> b is refused and printed"
      }
    ],
    "result": "A refused acquire fails fast with the cycle named, so neither agent hangs."
  },
